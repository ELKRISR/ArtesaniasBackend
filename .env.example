# =========================
# CONFIGURACIÓN DEL SERVIDOR
# =========================
PORT=4000

# =========================
# BASE DE DATOS
# =========================
DB_HOST=localhost
DB_USER=backend_user
DB_PASS=tu_password_segura
DB_NAME=artesanias_db

# =========================
# ENTORNO
# =========================
NODE_ENV=development
FORCE_SECURE_COOKIES=false

# =========================
# AUTENTICACIÓN (JWT)
# =========================
JWT_SECRET=tu_secreto_jwt_aqui
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=tu_secreto_refresh_jwt_aqui
JWT_REFRESH_EXPIRES_IN=7d

# =========================
# CSRF
# =========================
CSRF_SECRET=tu_secreto_csrf_aqui

# =========================
# BOLD - GATEWAY DE PAGOS
# =========================
# Para obtener estas credenciales, regístrate en:
# Producción: https://dashboard.bold.co/
# Sandbox: https://dashboard.sandbox.bold.co/

# Llave secreta de Bold (usada solo en backend)
BOLD_SECRET_KEY=tu_bold_secret_key_aqui
# Modo sandbox/test (true para desarrollo, false para producción)
BOLD_SANDBOX=true
# URL base de la API de Bold. Bold usa el mismo host para sandbox y
# producción: https://api.bold.com
# El modo sandbox se controla con `test: true` en el payload de la petición.
BOLD_BASE_URL=https://api.bold.com

# =========================
# FRONTEND URL
# =========================
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000


# =========================
# CORS - DOMINIOS PERMITIDOS (PRODUCCIÓN)
# =========================
# Ejemplo: agrega todos los dominios que usarán tu frontend en producción.
ALLOWED_ORIGINS=https://tusitio.com,https://www.tusitio.com,https://artesanias-katerine-r0s2z3eq5-elkrisrs-projects.vercel.app

# =========================
# SWAGGER - AUTENTICACIÓN BÁSICA (PRODUCCIÓN)
# =========================
SWAGGER_USER=usuario_swagger
SWAGGER_PASS=contrasena_segura_swagger

# URL pública de la API (para Swagger en producción)
API_URL=https://api.tusitio.com/api
